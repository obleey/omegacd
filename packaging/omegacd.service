# OmegaCD as a systemd service, in the .deb, not enabled: systemctl enable --now omegacd. See README.md, "Binary + systemd".
[Unit]
Description=OmegaCD - GitOps continuous delivery for Docker Compose
Documentation=https://github.com/obleey/omegacd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omegacd
Group=omegacd
ExecStart=/usr/bin/omegacd server
Restart=on-failure
RestartSec=5

Environment=OMEGACD_ADDR=:8080
Environment=OMEGACD_DATA=/var/lib/omegacd
# the Master Key, made at the first start in a folder of its own, which ProtectSystem leaves writable (Q254)
Environment=OMEGACD_AGE_KEY_FILE=/etc/omegacd/keys/age.key
# Optional settings (webhook secret, trusted proxies, ...) go here, mode 0600:
EnvironmentFile=-/etc/omegacd/omegacd.env

# /var/lib/omegacd, owned by the service user
StateDirectory=omegacd
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/etc/omegacd/keys
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
