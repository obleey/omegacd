#!/bin/sh
# omegacd reset-admin-password for the .deb's Control Plane (Q311, Q316): with its unit's settings and as its user, so
# the database's files and the new initial-admin-password stay the service's. Run it with sudo.
set -eu
[ "$(id -u)" = 0 ] || { echo "run it with sudo: sudo omegacd-reset-admin-password" >&2; exit 1; }
exec runuser -u omegacd -- env OMEGACD_DATA=/var/lib/omegacd OMEGACD_AGE_KEY_FILE=/etc/omegacd/keys/age.key \
	/usr/bin/omegacd reset-admin-password
